<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:global="clr-namespace:"
             xmlns:adc="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             x:Class="Alex80_IDE.Controls.MemoryView"
             x:DataType="global:MainViewModel"
             x:Name="Root">

    <Grid RowDefinitions="Auto,*">
        <!-- I comandi stanno a sinistra, dove comincia la lettura: sono il punto di
             partenza del pannello, non un accessorio in coda. -->
        <DockPanel Margin="14,14,14,10">
            <TextBlock Text="{Binding #Root.Title}"
                       Classes="sectionTitle"
                       DockPanel.Dock="Left"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       IsVisible="{Binding #Root.Title, Converter={x:Static adc:StringConverters.IsNotNullOrEmpty}}" />

            <StackPanel Orientation="Horizontal"
                        Spacing="6"
                        DockPanel.Dock="Left"
                        VerticalAlignment="Center"
                        IsVisible="{Binding #Root.ShowToolbar}">
                <TextBlock Text="Indirizzo" Classes="caption" VerticalAlignment="Center" />
                <TextBox Text="{Binding AddressHex, Mode=TwoWay}" Width="96" Classes="mono" />
                <TextBlock Text="Byte" Classes="caption" VerticalAlignment="Center" Margin="4,0,0,0" />
                <TextBox Text="{Binding NumBytes}" Width="62" Classes="mono" />

                <Button Classes="primary iconOnly"
                        Command="{Binding ReadMemoryCommand}"
                        Margin="4,0,0,0"
                        ToolTip.Tip="Leggi dalla scheda i byte indicati a partire dall'indirizzo">
                    <PathIcon Classes="btnIcon" Data="{DynamicResource MemoryReadIconData}" />
                </Button>
                <Button Classes="iconOnly"
                        Command="{Binding WriteMemoryCommand}"
                        ToolTip.Tip="Scrivi sulla scheda i byte mostrati, a partire dall'indirizzo">
                    <PathIcon Classes="btnIcon" Data="{DynamicResource MemoryWriteIconData}" />
                </Button>
                <Border Classes="separator" />
                <Button Classes="iconOnly"
                        Command="{Binding LoadBinaryCommand}"
                        ToolTip.Tip="Carica un file binario in questa vista, pronto per la scrittura">
                    <PathIcon Classes="btnIcon" Data="{DynamicResource LoadBinIconData}" />
                </Button>
            </StackPanel>

            <TextBlock Text="{Binding #Root.Caption}"
                       Classes="caption"
                       DockPanel.Dock="Right"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
        </DockPanel>

        <DataGrid Grid.Row="1"
                  Margin="14,0,14,0"
                  Name="MemoryGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  ItemsSource="{Binding DataTable}"
                  RowHeight="30"
                  HeadersVisibility="Column" />
    </Grid>
</UserControl>
