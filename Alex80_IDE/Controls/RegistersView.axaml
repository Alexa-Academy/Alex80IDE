<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:global="clr-namespace:"
             xmlns:vm="clr-namespace:Alex80_IDE.ViewModels"
             x:Class="Alex80_IDE.Controls.RegistersView"
             x:DataType="global:MainViewModel">

    <!-- Il titolo lo mette l'intestazione della tool window che ospita la vista.
         La spaziatura fra i riquadri sta nello stile registerChip: cosi' togliere
         o aggiungere un registro non costringe a rifare i margini a mano. -->
    <StackPanel Spacing="12">
        <Border Classes="registerChip" Padding="12">
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding InstructionTitle}" Classes="caption" />
                <TextBlock Text="{Binding InstructionStatus}" Classes="caption" TextWrapping="Wrap" />
                <StackPanel Spacing="8" IsVisible="{Binding HasInstruction}">
                    <TextBlock Text="{Binding CurrentInstruction.Header}" FontWeight="SemiBold" FontSize="17" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{Binding CurrentInstruction.OpcodeText}" Classes="mono" />
                        <TextBlock Text="{Binding CurrentInstruction.SizeText}" Classes="caption" />
                    </StackPanel>
                    <TextBlock Text="{Binding CurrentInstruction.Operation}" Classes="mono" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding CurrentInstruction.Timing}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding CurrentInstruction.MachineCycles}" Classes="caption" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding InstructionIdealTime}" Classes="caption" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding InstructionPrediction}" TextWrapping="Wrap" />
                    <Expander Header="Funzione, flag e riferimento">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding CurrentInstruction.Description}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding CurrentInstruction.Flags}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding CurrentInstruction.TimingNote}" Classes="caption" TextWrapping="Wrap" />
                            <Button Content="{Binding CurrentInstruction.ManualButtonText}" Command="{Binding OpenInstructionManualCommand}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- La rilettura sta qui e non nella barra in alto: e' qui che il risultato
             compare, e qui puo' spegnersi con la spiegazione accanto quando la scheda
             collegata non e' in grado di darli. -->
        <StackPanel Spacing="7">
            <CheckBox Content="Aggiorna automaticamente i registri"
                      IsChecked="{Binding AutoRefreshRegisters}"
                      ToolTip.Tip="{Binding RegisterRefreshToolTip}" />
            <TextBlock Text="{Binding RegisterRefreshToolTip}" Classes="caption" TextWrapping="Wrap" />
            <TextBlock Text="{Binding RegisterRefreshStatus}" Classes="caption" TextWrapping="Wrap" />
            <Button Classes="tool"
                    HorizontalAlignment="Left"
                    Command="{Binding DumpCommand}"
                    ToolTip.Tip="Rilegge i registri dalla scheda. Sull'eZ80 la CPU viene fermata e fatta ripartire da sola.">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <PathIcon Classes="btnIcon" Data="{DynamicResource RegistersIconData}" />
                    <TextBlock Text="Rileggi dalla scheda" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <TextBlock Classes="caption"
                       TextWrapping="Wrap"
                       IsVisible="{Binding !CanDumpRegisters}"
                       Text="{Binding DumpUnavailableText}" />
        </StackPanel>

        <!-- Le due viste sono elenchi e non riquadri scritti a mano: ogni cella deve
             poter dire da sola se il valore e' appena cambiato, e con i riquadri fissi
             voleva dire una proprieta' in piu' per ogni registro. La disposizione
             resta quella di prima, la griglia a tre colonne. -->

        <!-- Vista Z80: registri a 8 e 16 bit. -->
        <ItemsControl ItemsSource="{Binding Z80Registers}" IsVisible="{Binding !IsEz80}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CpuRegisterViewModel">
                    <Border Classes="registerChip"
                            Classes.changed="{Binding IsChanged}"
                            ToolTip.Tip="{Binding ToolTipText}">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" Classes="registerLabel" />
                            <TextBlock Text="{Binding ValueText}" Classes="registerValue" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Vista eZ80: coppie a 24 bit intere, piu' MBASE, STAT, lo stack
             pointer corto e i registri che il formato Z80 non rappresenta. -->
        <ItemsControl ItemsSource="{Binding Ez80Registers}" IsVisible="{Binding IsEz80}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CpuRegisterViewModel">
                    <Border Classes="registerChip"
                            Classes.changed="{Binding IsChanged}"
                            ToolTip.Tip="{Binding ToolTipText}">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" Classes="registerLabel" />
                            <TextBlock Text="{Binding ValueText}" Classes="registerValue" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- I flag su una riga a se': in un riquadro solo la stringa veniva
             troncata. Il WrapPanel manda a capo quando il pannello si stringe,
             cosi' resta leggibile a qualunque larghezza. Il registro F e' lo
             stesso sullo Z80 e sull'eZ80: la riga vale per tutte e due le viste. -->
        <StackPanel Spacing="6">
            <TextBlock Text="FLAGS" Classes="registerLabel" />
            <ItemsControl ItemsSource="{Binding Flags}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CpuFlagViewModel">
                        <Border Classes="flagChip"
                                Classes.set="{Binding IsSet}"
                                Classes.changed="{Binding IsChanged}"
                                ToolTip.Tip="{Binding ToolTipText}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Name}" Classes="flagName" />
                                <TextBlock Text="{Binding StateText}" Classes="flagState" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</UserControl>
