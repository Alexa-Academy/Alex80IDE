<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:global="clr-namespace:"
             xmlns:vm="clr-namespace:Alex80_IDE.ViewModels"
             x:Class="Alex80_IDE.Controls.RegistersView"
             x:DataType="global:MainViewModel">

    <!-- Il titolo lo mette l'intestazione della tool window che ospita la vista.
         La spaziatura fra i riquadri sta nello stile registerChip: cosi' togliere
         o aggiungere un registro non costringe a rifare i margini a mano. -->
    <StackPanel Spacing="12">
        <!-- La rilettura sta qui e non nella barra in alto: e' qui che il risultato
             compare, e qui puo' spegnersi con la spiegazione accanto quando la scheda
             collegata non e' in grado di darli. -->
        <StackPanel Spacing="7">
            <Button Classes="tool"
                    HorizontalAlignment="Left"
                    Command="{Binding DumpCommand}"
                    ToolTip.Tip="Rilegge i registri dalla scheda. Sull'eZ80 la CPU viene fermata e fatta ripartire da sola.">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <PathIcon Classes="btnIcon" Data="{DynamicResource RegistersIconData}" />
                    <TextBlock Text="Rileggi dalla scheda" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <TextBlock Classes="caption"
                       TextWrapping="Wrap"
                       IsVisible="{Binding !CanDumpRegisters}"
                       Text="{Binding DumpUnavailableText}" />
        </StackPanel>

        <!-- Vista Z80: registri a 8 e 16 bit. -->
        <UniformGrid Columns="3" IsVisible="{Binding !IsEz80}">
            <Border Classes="registerChip"><StackPanel><TextBlock Text="A" Classes="registerLabel" /><TextBlock Text="{Binding ARegHex}" Classes="registerValue" /></StackPanel></Border>
            <Border Classes="registerChip"><StackPanel><TextBlock Text="B" Classes="registerLabel" /><TextBlock Text="{Binding BRegHex}" Classes="registerValue" /></StackPanel></Border>
            <Border Classes="registerChip"><StackPanel><TextBlock Text="C" Classes="registerLabel" /><TextBlock Text="{Binding CRegHex}" Classes="registerValue" /></StackPanel></Border>
            <Border Classes="registerChip"><StackPanel><TextBlock Text="D" Classes="registerLabel" /><TextBlock Text="{Binding DRegHex}" Classes="registerValue" /></StackPanel></Border>
            <Border Classes="registerChip"><StackPanel><TextBlock Text="E" Classes="registerLabel" /><TextBlock Text="{Binding ERegHex}" Classes="registerValue" /></StackPanel></Border>
            <Border Classes="registerChip"><StackPanel><TextBlock Text="H" Classes="registerLabel" /><TextBlock Text="{Binding HRegHex}" Classes="registerValue" /></StackPanel></Border>
            <Border Classes="registerChip"><StackPanel><TextBlock Text="L" Classes="registerLabel" /><TextBlock Text="{Binding LRegHex}" Classes="registerValue" /></StackPanel></Border>
            <Border Classes="registerChip"><StackPanel><TextBlock Text="IX" Classes="registerLabel" /><TextBlock Text="{Binding IxRegHex}" Classes="registerValue" /></StackPanel></Border>
            <Border Classes="registerChip"><StackPanel><TextBlock Text="IY" Classes="registerLabel" /><TextBlock Text="{Binding IyRegHex}" Classes="registerValue" /></StackPanel></Border>
            <Border Classes="registerChip"><StackPanel><TextBlock Text="SP" Classes="registerLabel" /><TextBlock Text="{Binding SpRegHex}" Classes="registerValue" /></StackPanel></Border>
            <Border Classes="registerChip"><StackPanel><TextBlock Text="PC" Classes="registerLabel" /><TextBlock Text="{Binding PcRegHex}" Classes="registerValue" /></StackPanel></Border>
        </UniformGrid>

        <!-- Vista eZ80: coppie a 24 bit intere, piu' MBASE, STAT, lo stack
             pointer corto e i registri che il formato Z80 non rappresenta. -->
        <UniformGrid Columns="3" IsVisible="{Binding IsEz80}">
            <Border Classes="registerChip"><StackPanel><TextBlock Text="A" Classes="registerLabel" /><TextBlock Text="{Binding ARegHex}" Classes="registerValue" /></StackPanel></Border>
            <Border Classes="registerChip"><StackPanel><TextBlock Text="MB" Classes="registerLabel" /><TextBlock Text="{Binding MbRegHex}" Classes="registerValue" /></StackPanel></Border>
            <Border Classes="registerChip"><StackPanel><TextBlock Text="STAT" Classes="registerLabel" /><TextBlock Text="{Binding StatRegHex}" Classes="registerValue" /></StackPanel></Border>
            <Border Classes="registerChip"><StackPanel><TextBlock Text="BC" Classes="registerLabel" /><TextBlock Text="{Binding Bc24Hex}" Classes="registerValue" /></StackPanel></Border>
            <Border Classes="registerChip"><StackPanel><TextBlock Text="DE" Classes="registerLabel" /><TextBlock Text="{Binding De24Hex}" Classes="registerValue" /></StackPanel></Border>
            <Border Classes="registerChip"><StackPanel><TextBlock Text="HL" Classes="registerLabel" /><TextBlock Text="{Binding Hl24Hex}" Classes="registerValue" /></StackPanel></Border>
            <Border Classes="registerChip"><StackPanel><TextBlock Text="IX" Classes="registerLabel" /><TextBlock Text="{Binding IxRegHex}" Classes="registerValue" /></StackPanel></Border>
            <Border Classes="registerChip"><StackPanel><TextBlock Text="IY" Classes="registerLabel" /><TextBlock Text="{Binding IyRegHex}" Classes="registerValue" /></StackPanel></Border>
            <Border Classes="registerChip"><StackPanel><TextBlock Text="PC" Classes="registerLabel" /><TextBlock Text="{Binding PcRegHex}" Classes="registerValue" /></StackPanel></Border>
            <Border Classes="registerChip"><StackPanel><TextBlock Text="SPL" Classes="registerLabel" /><TextBlock Text="{Binding Spl24Hex}" Classes="registerValue" /></StackPanel></Border>
            <Border Classes="registerChip"><StackPanel><TextBlock Text="SPS" Classes="registerLabel" /><TextBlock Text="{Binding Sps16Hex}" Classes="registerValue" /></StackPanel></Border>
            <Border Classes="registerChip"><StackPanel><TextBlock Text="MODO" Classes="registerLabel" /><TextBlock Text="{Binding AdlText}" Classes="registerValue" /></StackPanel></Border>
            <Border Classes="registerChip"><StackPanel><TextBlock Text="I" Classes="registerLabel" /><TextBlock Text="{Binding IRegHex}" Classes="registerValue" /></StackPanel></Border>
            <Border Classes="registerChip"><StackPanel><TextBlock Text="R" Classes="registerLabel" /><TextBlock Text="{Binding RRegHex}" Classes="registerValue" /></StackPanel></Border>
        </UniformGrid>

        <!-- I flag su una riga a se': in un riquadro solo la stringa veniva
             troncata. Il WrapPanel manda a capo quando il pannello si stringe,
             cosi' resta leggibile a qualunque larghezza. Il registro F e' lo
             stesso sullo Z80 e sull'eZ80: la riga vale per tutte e due le viste. -->
        <StackPanel Spacing="6">
            <TextBlock Text="FLAGS" Classes="registerLabel" />
            <ItemsControl ItemsSource="{Binding Flags}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CpuFlagViewModel">
                        <Border Classes="flagChip"
                                Classes.set="{Binding IsSet}"
                                ToolTip.Tip="{Binding ToolTipText}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Name}" Classes="flagName" />
                                <TextBlock Text="{Binding StateText}" Classes="flagState" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</UserControl>
