<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:global="clr-namespace:"
             xmlns:models="clr-namespace:Alex80_IDE.Models"
             x:Class="Alex80_IDE.Controls.BusLogView"
             x:DataType="global:MainViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.busDot">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <!-- I comandi stanno a sinistra, dove comincia la lettura, come nel pannello
             della memoria. Registrazione, scorrimento e pulizia restano sulla prima
             riga; la scelta dei campioni sta sotto per restare leggibile anche stretta. -->
        <StackPanel Margin="14,14,14,10" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                <Button Content="{Binding BusLogToggleText}"
                        Classes="tool"
                        ToolTip.Tip="Registra continuamente il bus. Ogni colpo di clock manuale aggiunge un campione anche con il log continuo disabilitato."
                        Command="{Binding EnableDisableLogsCommand}" />

                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Scorrimento automatico" Classes="caption" VerticalAlignment="Center" />
                    <ToggleSwitch IsChecked="{Binding IsAutoScrollEnabled, Mode=TwoWay}" />
                </StackPanel>

                <Button Content="Cancella log" Classes="tool" Command="{Binding ClearLogsCommand}" />
            </StackPanel>
            <WrapPanel Orientation="Horizontal">
                <CheckBox Content="Segui esecuzione nel listing" Margin="0,0,18,0"
                          IsChecked="{Binding FollowListingExecution, Mode=TwoWay}"
                          ToolTip.Tip="Evidenzia l'ultimo fetch nel listing assemblato. Selezionando un log il seguito si sospende; riattiva questa opzione per riprenderlo." />
                <CheckBox Content="Tutti i clock"
                          IsChecked="{Binding FullLogEnabled, Mode=TwoWay}"
                          IsEnabled="{Binding CanConfigureLogMode}"
                          ToolTip.Tip="Include WAIT ripetuti, lettura dei registri e reset. La tabella cresce anche mentre la CPU è in pausa. Richiede un firmware che supporti questa opzione." />
            </WrapPanel>
            <TextBlock Text="{Binding ClockSummary}" Classes="caption" TextWrapping="Wrap" />
            <WrapPanel Orientation="Horizontal">
                <Button Content="Un colpo di clock" Command="{Binding PulseClockCommand}" Margin="0,0,8,0"
                        ToolTip.Tip="{Binding ClockPulseToolTip}" />
                <Button Content="Avanza un'istruzione" Command="{Binding AdvanceInstructionClockCommand}" Margin="0,0,8,0"
                        ToolTip.Tip="{Binding InstructionClockToolTip}" />
                <Button Content="Ferma avanzamento" IsVisible="{Binding IsInstructionClockRunning}"
                        Command="{Binding StopInstructionClockCommand}" />
            </WrapPanel>
            <TextBlock Text="{Binding InstructionClockStatus}" Classes="caption" TextWrapping="Wrap" />
            <TextBlock Text="T: posizione nell'istruzione; Tw: attesa. Anche il clock manuale usa questo conteggio. T?/Tw?: intervallo incompleto, in attesa del prossimo T1. —: dato assente o ciclo interno. In modalità compatta possono mancare campioni."
                       Classes="caption" TextWrapping="Wrap" />
        </StackPanel>

        <DataGrid Grid.Row="1"
                  Margin="14,0,14,0"
                  RowHeight="30"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  ItemsSource="{Binding LogTable}"
                  SelectedItem="{Binding SelectedLog, Mode=TwoWay}"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  HeadersVisibility="Column">
            <Interaction.Behaviors>
                <global:AutoScrollBehavior IsAutoScrollEnabled="{Binding IsAutoScrollEnabled}" />
            </Interaction.Behaviors>
            <DataGrid.Columns>
                <DataGridTextColumn Header="T / WAIT" Binding="{Binding TStateText}" Width="110" />
                <DataGridTextColumn Header="ADDR" Binding="{Binding AddressHex}" Width="90" />
                <DataGridTextColumn Header="DATA" Binding="{Binding DataHex}" Width="76" />
                <DataGridTemplateColumn Header="RD" Width="54">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:LogElement">
                            <TextBlock Text="{Binding Z80_RD, Converter={StaticResource BoolToDotConverter}}" Classes="busDot" Foreground="{DynamicResource AccentBrush}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="WR" Width="54">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:LogElement">
                            <TextBlock Text="{Binding Z80_WR, Converter={StaticResource BoolToDotConverter}}" Classes="busDot" Foreground="{DynamicResource WarningBrush}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="IORQ" Width="62">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:LogElement">
                            <TextBlock Text="{Binding Z80_IORQ, Converter={StaticResource BoolToDotConverter}}" Classes="busDot" Foreground="{DynamicResource AccentBrush}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="MREQ" Width="68">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:LogElement">
                            <TextBlock Text="{Binding Z80_MREQ, Converter={StaticResource BoolToDotConverter}}" Classes="busDot" Foreground="{DynamicResource AccentBrush}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="RFSH" Width="64">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:LogElement">
                            <TextBlock Text="{Binding Z80_RFSH, Converter={StaticResource BoolToDotConverter}}" Classes="busDot" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="M1" Width="54">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:LogElement">
                            <TextBlock Text="{Binding Z80_M1, Converter={StaticResource BoolToDotConverter}}" Classes="busDot" Foreground="{DynamicResource DangerBrush}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="FASE" Binding="{Binding TracePhase}" Width="125" />
                <DataGridTextColumn Header="MNEMONICO" Binding="{Binding Mnemonic}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
