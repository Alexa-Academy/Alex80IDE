<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#111318" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#181B22" />
            <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#20242D" />
            <SolidColorBrush x:Key="SurfaceInputBrush" Color="#14171D" />
            <SolidColorBrush x:Key="TabActiveBrush" Color="#2A303B" />
            <SolidColorBrush x:Key="BorderSoftBrush" Color="#313744" />
            <!-- Separazione appena accennata fra i riquadri dell'area di lavoro. -->
            <SolidColorBrush x:Key="BorderHairlineBrush" Color="#23272F" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F0F4FA" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#98A2B3" />
            <SolidColorBrush x:Key="AccentBrush" Color="#4CC9A7" />
            <SolidColorBrush x:Key="AccentStrongBrush" Color="#2FAE8E" />
            <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="DangerBrush" Color="#E66767" />
            <SolidColorBrush x:Key="WarningBrush" Color="#EAB85F" />
            <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#332024" />
            <SolidColorBrush x:Key="DangerTextBrush" Color="#FFDCDC" />
            <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#1C3A35" />
            <SolidColorBrush x:Key="EditorSelectionBrush" Color="#805FB3F3" />
            <SolidColorBrush x:Key="EditorSearchResultsBrush" Color="#66F2C94C" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#EEF2F7" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#F3F6FA" />
            <SolidColorBrush x:Key="SurfaceInputBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TabActiveBrush" Color="#E6EBF2" />
            <SolidColorBrush x:Key="BorderSoftBrush" Color="#C9D2DF" />
            <SolidColorBrush x:Key="BorderHairlineBrush" Color="#E4E9F0" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#18202B" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5E6978" />
            <SolidColorBrush x:Key="AccentBrush" Color="#087D6C" />
            <SolidColorBrush x:Key="AccentStrongBrush" Color="#0D9488" />
            <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="DangerBrush" Color="#C73535" />
            <SolidColorBrush x:Key="WarningBrush" Color="#9A6400" />
            <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#FCE8E8" />
            <SolidColorBrush x:Key="DangerTextBrush" Color="#8B1E1E" />
            <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#DDF6F1" />
            <SolidColorBrush x:Key="EditorSelectionBrush" Color="#6638BDF8" />
            <SolidColorBrush x:Key="EditorSearchResultsBrush" Color="#66F59E0B" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <FontFamily x:Key="UiFontFamily">Inter, Segoe UI, Helvetica Neue, Arial</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Menlo, Consolas, Courier New</FontFamily>

    <StreamGeometry x:Key="MemoryIconData">M7,5 L7,3 L9,3 L9,5 L11,5 L11,3 L13,3 L13,5 L15,5 L15,3 L17,3 L17,5 L19,5 L19,7 L21,7 L21,9 L19,9 L19,11 L21,11 L21,13 L19,13 L19,15 L21,15 L21,17 L19,17 L19,19 L17,19 L17,21 L15,21 L15,19 L13,19 L13,21 L11,21 L11,19 L9,19 L9,21 L7,21 L7,19 L5,19 L5,17 L3,17 L3,15 L5,15 L5,13 L3,13 L3,11 L5,11 L5,9 L3,9 L3,7 L5,7 L5,5 Z M8,8 L8,16 L16,16 L16,8 Z M10,10 L14,10 L14,14 L10,14 Z</StreamGeometry>
    <!-- Icone dei comandi, disegnate su una griglia 24x24.
         Comandi della memoria. Lettura e scrittura sono la stessa freccia specchiata,
         con il chip sempre dalla parte della scheda: si legge da li' e si scrive li'. -->
    <StreamGeometry x:Key="MemoryReadIconData">M17,7 H22 V17 H17 Z M18.5,9 V15 H20.5 V9 Z M2,12 L8,6 V10 H15 V14 H8 V18 Z</StreamGeometry>
    <StreamGeometry x:Key="MemoryWriteIconData">M17,7 H22 V17 H17 Z M18.5,9 V15 H20.5 V9 Z M15,12 L9,6 V10 H2 V14 H9 V18 Z</StreamGeometry>
    <!-- Carica bin: un file, non una freccia, per non confonderlo con la lettura. -->
    <StreamGeometry x:Key="LoadBinIconData">M5,2 H14 L19,7 V22 H5 Z M7,4 V20 H17 V9 H12 V4 Z M11,11 H13 V15 H16 L12,19 L8,15 H11 Z</StreamGeometry>
    <StreamGeometry x:Key="ResetIconData">M5,4 H7 V20 H5 Z M20,4 V20 L9,12 Z</StreamGeometry>
    <!-- Triangolo di play: manda in esecuzione il programma caricato. -->
    <StreamGeometry x:Key="RunIconData">M7,4 L20,12 L7,20 Z</StreamGeometry>
    <StreamGeometry x:Key="StepIconData">M3,10 H13 V6 L19,12 L13,18 V14 H3 Z M20,4 H22 V20 H20 Z</StreamGeometry>
    <StreamGeometry x:Key="BusLogIconData">M2,13 H8 V15 H2 Z M8,7 H10 V15 H8 Z M10,7 H14 V9 H10 Z M14,7 H16 V15 H14 Z M16,13 H20 V15 H16 Z M20,7 H22 V15 H20 Z</StreamGeometry>
    <!-- Icone delle tool window nelle strip di bordo. -->
    <StreamGeometry x:Key="AssemblerIconData">M10,2 H14 V6 H10 Z M10,18 H14 V22 H10 Z M2,10 H6 V14 H2 Z M18,10 H22 V14 H18 Z M6,6 H18 V18 H6 Z M9,9 V15 H15 V9 Z</StreamGeometry>
    <StreamGeometry x:Key="BoardIconData">M3,6 H21 V7.5 H3 Z M7,4 H9.5 V9.5 H7 Z M3,11.25 H21 V12.75 H3 Z M14,9.25 H16.5 V14.75 H14 Z M3,16.5 H21 V18 H3 Z M9,14.5 H11.5 V20 H9 Z</StreamGeometry>
    <StreamGeometry x:Key="ProjectIconData">M3,4 H10 L12,6 H21 V20 H3 Z M5,8 V18 H19 V8 Z M7,10 H17 V11.5 H7 Z M7,13 H14 V14.5 H7 Z</StreamGeometry>
    <StreamGeometry x:Key="RegistersIconData">M3,4 H21 V20 H3 Z M5,6 V18 H19 V6 Z M5,10 H19 V11.5 H5 Z M5,14 H19 V15.5 H5 Z M10,6 H11.5 V18 H10 Z</StreamGeometry>
    <StreamGeometry x:Key="SerialIconData">M4,5 L20,5 C21.1,5 22,5.9 22,7 L22,17 C22,18.1 21.1,19 20,19 L4,19 C2.9,19 2,18.1 2,17 L2,7 C2,5.9 2.9,5 4,5 Z M5,7 L5,17 L19,17 L19,7 Z M7,9 L10.5,12 L7,15 L8.3,16 L13,12 L8.3,8 Z M13,14 L17,14 L17,15.7 L13,15.7 Z</StreamGeometry>

</ResourceDictionary>
