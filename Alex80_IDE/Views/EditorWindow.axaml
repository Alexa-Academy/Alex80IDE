<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:edit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        xmlns:global="clr-namespace:"
        xmlns:views="clr-namespace:Alex80_IDE"
        x:Class="Alex80_IDE.EditorWindow"
        x:DataType="global:MainViewModel"
        Title="Editor assembler"
        Width="1000"
        Height="700"
        MinWidth="620"
        MinHeight="420"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="{DynamicResource UiFontFamily}">

    <Window.Styles>
        <Style Selector="TabControl">
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
        </Style>

        <Style Selector="TabItem">
            <Setter Property="Padding" Value="10,7" />
        </Style>
    </Window.Styles>

    <Border Margin="14"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderSoftBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid RowDefinitions="Auto,*">
            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        Margin="12"
                        VerticalAlignment="Center">
                <Button Command="{Binding NewTabCommand}" Content="Nuova" />
                <Button Command="{Binding OpenFileCommand}" Content="Apri" />
                <Button Command="{Binding SaveFileCommand}" Content="Salva" />
                <Button Command="{Binding SaveFileAsCommand}" Content="Salva con nome" />
                <Button Command="{Binding AssembleCommand}" Content="Assembla" />
                <Button Command="{Binding SaveArduinoArrayCommand}" Content="Salva array Arduino" />
            </StackPanel>

            <TabControl Grid.Row="1"
                        ItemsSource="{Binding OpenDocuments}"
                        SelectedItem="{Binding SelectedDocument}">
                <TabControl.ItemTemplate>
                    <DataTemplate x:DataType="global:DocumentViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding FileName}" />
                            <Button Content="x"
                                    Classes="closeTab"
                                    Command="{Binding $parent[views:EditorWindow].((global:MainViewModel)DataContext).CloseTabCommand}"
                                    CommandParameter="{Binding}"
                                    VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>

                <TabControl.ContentTemplate>
                    <DataTemplate x:DataType="global:DocumentViewModel">
                        <Grid RowDefinitions="*" Margin="12">
                            <edit:TextEditor Document="{Binding EditorDocument}"
                                             FontFamily="{DynamicResource MonoFontFamily}"
                                             FontSize="15"
                                             Background="{DynamicResource SurfaceInputBrush}"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             LineNumbersForeground="{DynamicResource TextSecondaryBrush}"
                                             SearchResultsBrush="{DynamicResource EditorSearchResultsBrush}"
                                             SyntaxHighlighting="Z80"
                                             ShowLineNumbers="True"
                                             WordWrap="False"
                                             HorizontalScrollBarVisibility="Auto"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch" />
                        </Grid>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </Grid>
    </Border>
</Window>
