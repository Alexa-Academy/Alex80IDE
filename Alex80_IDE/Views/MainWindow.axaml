<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:global="clr-namespace:"
        xmlns:views="clr-namespace:Alex80_IDE"
        xmlns:controls="clr-namespace:Alex80_IDE.Controls"
        xmlns:vm="clr-namespace:Alex80_IDE.ViewModels"
        x:Class="Alex80_IDE.MainWindow"
        x:DataType="global:MainViewModel"
        Icon="/Assets/alex80.ico"
        Title="Alex80 IDE"
        Width="1480"
        Height="1000"
        MinWidth="1160"
        MinHeight="780"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="{DynamicResource UiFontFamily}">

    <Window.Resources>
        <!-- Pulsante di una tool window nella strip di bordo: icona sola, acceso quando il
             suo pannello e' quello aperto. -->
        <DataTemplate x:Key="ToolStripButtonTemplate" x:DataType="vm:ToolWindowViewModel">
            <Button Classes="toolStripButton"
                    Classes.active="{Binding IsActive}"
                    Command="{Binding ToggleCommand}"
                    IsEnabled="{Binding IsAvailable}"
                    ToolTip.Tip="{Binding Title}">
                <PathIcon Classes="stripIcon"
                          Data="{Binding IconKey, Converter={StaticResource ResourceKeyConverter}}" />
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Barra dei menu. Su macOS il menu e' esportato nella barra di sistema e questo
             controllo non occupa spazio; su Windows e Linux e' qui che compare. -->
        <NativeMenuBar Grid.Row="0" HorizontalAlignment="Left" />

        <!-- Connessione e controlli hardware restano accessibili mentre si osservano
             i registri. Su finestre strette i gruppi vanno a capo senza coprirsi. -->
        <Border Grid.Row="1" Classes="appBar">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <WrapPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,2,12,2">
                        <TextBlock Text="Alex80 IDE"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Border Classes="separator" />
                        <TextBlock Text="Porta" Classes="caption" VerticalAlignment="Center" />
                        <ComboBox x:Name="PortsDropdown"
                                  Width="180"
                                  ItemsSource="{Binding PortsList}"
                                  SelectedIndex="{Binding SelectedIdx, Mode=TwoWay}" />
                        <TextBlock Text="Baud" Classes="caption" VerticalAlignment="Center" />
                        <ComboBox x:Name="BaudRateDropdown"
                                  Width="100"
                                  ItemsSource="{Binding BaudRates}"
                                  SelectedItem="{Binding SelectedBaudRate, Mode=TwoWay}"
                                  IsEnabled="{Binding !IsSerialOpened}"
                                  ToolTip.Tip="Velocità della seriale in baud. Seleziona il valore configurato nello sketch prima di aprire la porta." />
                        <Button Content="{Binding ToggleButtonContent}"
                                Classes="tool"
                                Command="{Binding OpenCloseSerialPortCommand}" />
                    </StackPanel>
                    <controls:BoardToolbarView Margin="0,2" VerticalAlignment="Center" />
                </WrapPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top" Margin="0,4,0,0">
                    <!-- Assembla sta con i comandi di esecuzione, come negli IDE: si
                         costruisce e si manda in esecuzione con lo stesso gesto. -->
                    <Button Command="{Binding AssembleCommand}" Classes="iconOnly"
                            ToolTip.Tip="{Binding CommandModifierName, StringFormat='Assembla ({0}+B)'}">
                        <PathIcon Classes="btnIcon" Data="{DynamicResource AssembleIconData}" />
                    </Button>
                    <Border Classes="separator" />
                    <Button Classes="danger iconOnly"
                            ToolTip.Tip="Reset"
                            Command="{Binding ResetCommand}"
                            IsEnabled="{Binding IsBoardConnected}">
                        <PathIcon Classes="btnIcon" Data="{DynamicResource ResetIconData}" />
                    </Button>
                    <!-- Un solo comando, significato uniforme: manda in
                         esecuzione il programma caricato. Sull'Alex80 e' un NMI,
                         sull'eZ80 e' il caricamento del PC seguito da continue. -->
                    <Button Classes="iconOnly"
                            Command="{Binding RunCommand}"
                            IsEnabled="{Binding CanRun}"
                            ToolTip.Tip="{Binding RunToolTip}">
                        <PathIcon Classes="btnIcon" Data="{DynamicResource RunIconData}" />
                    </Button>
                    <!-- Ogni accesso a memoria via ZDI richiede il core fermo:
                         averlo sotto controllo esplicito rende evidente in che
                         stato si sta leggendo. -->
                    <Button Classes="iconOnly"
                            Command="{Binding ToggleBreakCommand}"
                            IsVisible="{Binding IsEz80Context}"
                            IsEnabled="{Binding IsBoardConnected}"
                            ToolTip.Tip="{Binding BreakButtonToolTip}">
                        <PathIcon Classes="btnIcon"
                                  Data="{Binding BreakButtonIconKey, Converter={StaticResource ResourceKeyConverter}}" />
                    </Button>
                    <Button Classes="iconOnly"
                            ToolTip.Tip="{Binding StepToolTip}"
                            Command="{Binding StepCommand}"
                            IsEnabled="{Binding IsBoardConnected}">
                        <PathIcon Classes="btnIcon" Data="{DynamicResource StepIconData}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Area di lavoro. Le strip di bordo sono sempre visibili: ogni pannello si apre
             e si chiude dalla propria icona, come in Rider e Android Studio. La misura dei
             pannelli e' gestita da ToolDockLayout, nel code-behind. -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto">

            <!-- Strip di sinistra, due gruppi come negli IDE JetBrains: in alto gli
                 strumenti che si aprono di fianco, in basso quelli che si aprono sotto. -->
            <Border Grid.Column="0"
                    Classes="toolStrip left"
                    IsVisible="{Binding HasLeftStripTools}">
                <DockPanel LastChildFill="False">
                    <ItemsControl DockPanel.Dock="Top"
                                  ItemsSource="{Binding LeftDock.Tools}"
                                  ItemTemplate="{StaticResource ToolStripButtonTemplate}" />
                    <ItemsControl DockPanel.Dock="Bottom"
                                  ItemsSource="{Binding BottomDock.Tools}"
                                  ItemTemplate="{StaticResource ToolStripButtonTemplate}" />
                </DockPanel>
            </Border>

            <!-- Le misure delle righe e colonne che ospitano i pannelli sono gestite dal
                 code-behind: vedi gli indici in MainWindow.axaml.cs. -->
            <Grid x:Name="WorkAreaGrid" Grid.Column="1" Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="200" />
                    <RowDefinition Height="Auto" />
                    <!-- 2: pannello del dock inferiore -->
                    <RowDefinition Height="300" />
                </Grid.RowDefinitions>

                <Grid x:Name="CenterGrid" Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <!-- 0: pannello del dock sinistro -->
                        <ColumnDefinition Width="270" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="260" />
                        <ColumnDefinition Width="Auto" />
                        <!-- 4: pannello del dock destro -->
                        <ColumnDefinition Width="330" />
                    </Grid.ColumnDefinitions>

                    <!-- Dock sinistro: i file che compongono il programma e come vanno assemblati. -->
                    <Border Grid.Column="0" Classes="panel" IsVisible="{Binding LeftDock.IsPanelVisible}">
                        <Grid RowDefinitions="Auto,*">
                            <Border Classes="toolPanelHeader">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding LeftDock.HeaderTitle}" Classes="toolPanelTitle" />
                                    <Button Grid.Column="1" Content="✕" Classes="closeTab"
                                            Command="{Binding LeftDock.CloseCommand}"
                                            ToolTip.Tip="Chiudi il pannello" />
                                </Grid>
                            </Border>

                            <Panel Grid.Row="1">
                                <Grid IsVisible="{Binding ProjectTool.IsActive}"
                                  RowDefinitions="Auto,*"
                                  Margin="12">
                                <TextBlock Text="{Binding ProjectTitle}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding CurrentProject.ProjectPath}" />

                                <TextBlock Grid.Row="1"
                                           Classes="caption"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Top"
                                           Margin="0,10,0,0"
                                           IsVisible="{Binding !HasProject}"
                                           Text="Nessun progetto aperto: &quot;Assembla&quot; lavora sul sorgente selezionato. Crea un progetto dal menu File per assemblare più file in un unico binario." />

                                <!-- Le azioni sui file stanno nel menu contestuale, come negli
                                     IDE: le righe restano leggibili anche strette, e i sorgenti
                                     si aggiungono anche trascinandoli qui sopra. -->
                                <ListBox Grid.Row="1"
                                         x:Name="ProjectFilesList"
                                         Classes="projectFiles"
                                         Margin="0,10,0,0"
                                         DragDrop.AllowDrop="True"
                                         IsVisible="{Binding HasProject}"
                                         ItemsSource="{Binding ProjectFiles}">
                                    <ListBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Aggiungi file al progetto..."
                                                      Command="{Binding AddFilesToProjectCommand}" />
                                        </ContextMenu>
                                    </ListBox.ContextMenu>

                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ProjectFileViewModel">
                                            <Grid RowDefinitions="Auto,Auto">
                                                <!-- Il menu sta sulla riga e non sulla ListBox: cosi'
                                                     eredita il file come DataContext, che dentro un
                                                     popup e' l'unico modo per sapere su cosa agire. -->
                                                <Grid.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Apri" Command="{Binding OpenCommand}" />
                                                        <MenuItem Header="Rendi principale" Command="{Binding MakeMainCommand}" />
                                                        <Separator />
                                                        <MenuItem Header="Sposta su" Command="{Binding MoveUpCommand}" />
                                                        <MenuItem Header="Sposta giù" Command="{Binding MoveDownCommand}" />
                                                        <Separator />
                                                        <MenuItem Header="Aggiungi file al progetto..." Command="{Binding AddFilesCommand}" />
                                                        <MenuItem Header="Togli dal progetto" Command="{Binding RemoveCommand}" />
                                                    </ContextMenu>
                                                </Grid.ContextMenu>

                                                <Button Classes="fileLink"
                                                        Content="{Binding FileName}"
                                                        Command="{Binding OpenCommand}"
                                                        ToolTip.Tip="{Binding AbsolutePath}" />

                                                <StackPanel Grid.Row="1"
                                                            Orientation="Horizontal" Spacing="6" Margin="8,0,0,2">
                                                    <TextBlock Text="principale" Classes="fileBadge" IsVisible="{Binding IsMain}" />
                                                    <TextBlock Text="{Binding SubFolder}" Classes="caption" IsVisible="{Binding HasSubFolder}" />
                                                    <TextBlock Text="{Binding Placement}" Classes="statusValue" />
                                                    <TextBlock Text="non trovato" Classes="caption"
                                                               Foreground="{DynamicResource DangerBrush}"
                                                               IsVisible="{Binding IsMissing}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>

                                <ScrollViewer IsVisible="{Binding AssemblerTool.IsActive}"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <controls:AssemblerSettingsView Margin="12" />
                                </ScrollViewer>
                            </Panel>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Column="1"
                                  Width="6"
                                  Cursor="SizeWestEast"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  ResizeDirection="Columns"
                                  IsVisible="{Binding LeftDock.IsPanelVisible}" />

                    <Border Grid.Column="2" Classes="panel">
                        <Grid>
                            <controls:WorkspaceWelcomeView IsVisible="{Binding IsWorkspaceEmpty}" />
                            <TabControl Classes="workspaceTabs"
                                        IsVisible="{Binding !IsWorkspaceEmpty}"
                                        Margin="6,4,6,0"
                                        ItemsSource="{Binding OpenDocuments}"
                                        SelectedItem="{Binding SelectedDocument}">
                                <TabControl.ItemTemplate>
                                    <DataTemplate x:DataType="global:DocumentViewModel">
                                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName, Converter={StaticResource FileTypeBadgeConverter}}"
                                                       Classes="fileBadge" />
                                            <TextBlock Text="{Binding FileName}"
                                                       VerticalAlignment="Center"
                                                       Classes="tabTitle"
                                                       Classes.dirty="{Binding IsDirty}" />
                                            <Ellipse Classes="dirtyDot"
                                                     ToolTip.Tip="Modifiche non salvate"
                                                     IsVisible="{Binding IsDirty}" />
                                            <Button Content="✕"
                                                    Classes="closeTab"
                                                    FontSize="10"
                                                    ToolTip.Tip="{Binding $parent[views:MainWindow].((global:MainViewModel)DataContext).CommandModifierName, StringFormat='Chiudi ({0}+W)'}"
                                                    Command="{Binding $parent[views:MainWindow].((global:MainViewModel)DataContext).CloseTabCommand}"
                                                    CommandParameter="{Binding}"
                                                    IsVisible="{Binding $parent[TabItem].IsSelected}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </TabControl.ItemTemplate>

                                <TabControl.ContentTemplate>
                                    <DataTemplate x:DataType="global:DocumentViewModel">
                                        <controls:ExecutionListingEditor Document="{Binding EditorDocument}"
                                                         ExecutionLine="{Binding ExecutionLine}"
                                                         ExecutionBrush="{DynamicResource WarningBrush}"
                                                         FontFamily="{DynamicResource MonoFontFamily}"
                                                         FontSize="15"
                                                         Background="{DynamicResource SurfaceInputBrush}"
                                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                                         LineNumbersForeground="{DynamicResource TextSecondaryBrush}"
                                                         SearchResultsBrush="{DynamicResource EditorSearchResultsBrush}"
                                                         SyntaxHighlighting="Z80"
                                                         ShowLineNumbers="True"
                                                         WordWrap="False"
                                                         HorizontalScrollBarVisibility="Auto"
                                                         VerticalScrollBarVisibility="Auto"
                                                         HorizontalAlignment="Stretch"
                                                         VerticalAlignment="Stretch" />
                                    </DataTemplate>
                                </TabControl.ContentTemplate>
                            </TabControl>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Column="3"
                                  Width="6"
                                  Cursor="SizeWestEast"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  ResizeDirection="Columns"
                                  IsVisible="{Binding RightDock.IsPanelVisible}" />

                    <!-- Dock destro: lo stato della CPU e gli strumenti di osservazione. -->
                    <Border Grid.Column="4" Classes="panel" IsVisible="{Binding RightDock.IsPanelVisible}">
                        <Grid RowDefinitions="Auto,*">
                            <Border Classes="toolPanelHeader">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding RightDock.HeaderTitle}" Classes="toolPanelTitle" />
                                    <Button Grid.Column="1" Content="✕" Classes="closeTab"
                                            Command="{Binding RightDock.CloseCommand}"
                                            ToolTip.Tip="Chiudi il pannello" />
                                </Grid>
                            </Border>

                            <Panel Grid.Row="1">
                                <ScrollViewer IsVisible="{Binding RegistersTool.IsActive}"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <controls:RegistersView Margin="14" />
                                </ScrollViewer>
                            </Panel>
                        </Grid>
                    </Border>
                </Grid>

                <GridSplitter Grid.Row="1"
                              Height="6"
                              Cursor="SizeNorthSouth"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              ResizeDirection="Rows"
                              IsVisible="{Binding BottomDock.IsPanelVisible}" />

                <!-- Dock inferiore: gli strumenti di osservazione della scheda. Le loro
                     icone stanno in fondo alla strip di sinistra. -->
                <Border Grid.Row="2" Classes="panel" IsVisible="{Binding BottomDock.IsPanelVisible}">
                    <Grid RowDefinitions="Auto,*">
                        <Border Classes="toolPanelHeader" IsVisible="{Binding !BusLogTool.IsActive}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding BottomDock.HeaderTitle}" Classes="toolPanelTitle" />
                                <Button Grid.Column="1" Content="✕" Classes="closeTab"
                                        Command="{Binding BottomDock.CloseCommand}"
                                        ToolTip.Tip="Chiudi il pannello" />
                            </Grid>
                        </Border>

                        <Panel Grid.Row="1">
                            <controls:MemoryView Title="" ShowToolbar="True"
                                                 IsVisible="{Binding MemoryTool.IsActive}" />
                            <controls:BusLogView IsVisible="{Binding BusLogTool.IsActive}" />
                            <controls:SerialConsoleView Title="" Margin="14"
                                                        IsVisible="{Binding SerialTool.IsActive}" />
                        </Panel>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="2"
                    Classes="toolStrip right"
                    IsVisible="{Binding RightDock.HasTools}">
                <ItemsControl ItemsSource="{Binding RightDock.Tools}"
                              ItemTemplate="{StaticResource ToolStripButtonTemplate}" />
            </Border>
        </Grid>

        <!-- Notifica sovrapposta e non modale: segnala l'attesa senza prendere il
             fuoco, intercettare clic o spostare i pannelli dell'area di lavoro. -->
        <Border Grid.Row="2" ZIndex="10" Classes="connectionNotice"
                IsVisible="{Binding IsConnectionNoticeVisible}" IsHitTestVisible="False"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                MaxWidth="420" Margin="12,10,12,0">
            <StackPanel Spacing="7">
                <TextBlock Text="{Binding ConnectionNoticeText}" FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding ConnectionNoticeDetail}" Classes="caption"
                           TextWrapping="Wrap" />
                <ProgressBar IsIndeterminate="{Binding IsConnectionInProgress}"
                             IsVisible="{Binding IsConnectionInProgress}"
                             Height="3" />
            </StackPanel>
        </Border>

        <!-- Status bar: stato della scheda e contesto di lavoro. PC e SP stanno
             nella tool window dei registri. -->
        <Border Grid.Row="3" Classes="statusBar">
            <Grid ColumnDefinitions="*,Auto">
                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,14,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CardConnectionText}" Classes="statusItem boardConnection"
                               Classes.connected="{Binding IsBoardConnected}"
                               Classes.firmwareWarning="{Binding HasFirmwareWarning}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding CardConnectionToolTip}" />
                    <TextBlock Grid.Column="1" Margin="14,0,0,0"
                               Text="{Binding MonitorStatusText}"
                               Classes="statusItem" />
                    <!-- L'avanzamento della scrittura sulla scheda: sta nella status bar,
                         che e' il posto dove si guarda come sta andando un'operazione. -->
                    <ProgressBar Grid.Column="2" Margin="14,0,0,0" Minimum="0"
                                 Maximum="100"
                                 Width="160"
                                 Height="6"
                                 VerticalAlignment="Center"
                                 Value="{Binding ProgressValue}"
                                 IsVisible="{Binding ProgressVisible}" />
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedDocument.FileName, FallbackValue=''}" Classes="statusItem" />
                    <TextBlock Text="{Binding ProjectTitle, StringFormat='progetto: {0}'}" Classes="statusItem" />
                    <!-- La CPU di destinazione si legge qui invece che aprendo il pannello
                         dell'assemblatore: decide cosa esce dall'assemblata, ed e' la prima
                         cosa da guardare quando il risultato non e' quello atteso. -->
                    <TextBlock Text="{Binding CpuStatusText}"
                               Classes="statusItem"
                               ToolTip.Tip="CPU per cui si assembla, e modo di indirizzamento quando i due non coincidono. CPU e modo si scelgono nel pannello Assemblatore." />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
